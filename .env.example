# ============================================================
# F1 RaceLab — local development
# ============================================================

RACELAB_ENV=development

# API
RACELAB_API_HOST=0.0.0.0
RACELAB_API_PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=racelab
POSTGRES_USER=racelab
POSTGRES_PASSWORD=racelab
DATABASE_URL=postgresql+psycopg://racelab:racelab@localhost:5432/racelab

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=racelab
MINIO_SECRET_KEY=racelab-dev-password
MINIO_BUCKET=racelab

# OpenF1
OPENF1_BASE_URL=https://api.openf1.org/v1

# Local data
RACELAB_DATA_DIR=./data
FASTF1_CACHE_DIR=./data/cache/fastf1
